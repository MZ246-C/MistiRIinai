# ─────────────────────────────────────────────────────────────────
# MistiRinai — environment variables
# Copy this file to `.env` for local development. Never commit `.env`.
# In production, set these in Netlify → Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────

# ---- BROWSER-SAFE (prefixed VITE_, bundled into the frontend) ----
# The Supabase anon key is safe for the browser ONLY because Row Level
# Security (RLS) is enabled on every table — see supabase/migrations.
# The browser never talks to Supabase directly for private data; it only
# uses this to satisfy the supabase-js client used indirectly. Memories
# and calendar data always go through our own Netlify Functions, which
# use the SERVICE ROLE key server-side.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---- SERVER-ONLY (Netlify Functions runtime, NEVER sent to the browser) ----

# Full Supabase project URL (server side copy, same value as above is fine)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase service role key — full DB/storage access, bypasses RLS.
# Get this from Supabase → Project settings → API → service_role secret.
# This must ONLY ever be read inside netlify/functions/*, never in src/.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The private storage bucket name used for uploaded memories.
SUPABASE_STORAGE_BUCKET=memories

# The initial shared password for the Memory Booth (set once).
# On first login attempt, the server hashes this value and stores the
# hash in the `app_config` table — after that, this env var is only used
# as the seed and can be rotated by changing it + clearing app_config.password_hash.
INITIAL_ADMIN_PASSWORD=MistiRinai

# Secret used to sign the session JWT stored in the HttpOnly cookie.
# Generate a strong random value, e.g.: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# Cookie security — set to "true" in production (requires HTTPS, which
# Netlify provides by default). Keep "false" only for local http dev if needed.
SECURE_COOKIES=true

# Session lifetime, in hours.
SESSION_TTL_HOURS=12

# Max failed login attempts allowed per IP within the lockout window.
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Upload limits, in megabytes. Read server-side by uploads-create.ts.
MAX_UPLOAD_MB_IMAGE=25
MAX_UPLOAD_MB_VIDEO=500
MAX_UPLOAD_MB_AUDIO=100
MAX_UPLOAD_MB_DOCUMENT=25

# Signed URL lifetime, in seconds, for viewing/downloading private files.
SIGNED_URL_TTL_SECONDS=300
